{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "UseInMemoryDb": false,
    "UseSqlServer": true
  },
  "ConnectionStrings": {
    "OrdersDb": "Server=(localdb)\\MSSQLLocalDB;Database=XpressTest_Orders;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Ids": {
    "WorkerId": 2
  },
  "Auth": {
    "Authority": "http://localhost:5101"
  },
  "Notifications": {
    "BaseUrl": "http://localhost:5103"
  },
  "ServiceClient": {
    "ClientId": "order-service",
    "Scope": "notifications.send"
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "RateLimiting": {
    "Policies": {
      "api": { "PermitLimit": 100, "Window": "00:01:00" },
      "orders-create": { "PermitLimit": 3, "Window": "00:01:00" },
      "orders-edit": { "PermitLimit": 3, "Window": "00:01:00" }
    }
  }
}
