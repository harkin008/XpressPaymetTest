{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "UseInMemoryDb": false,
    "UseSqlServer": true
  },
  "ConnectionStrings": {
    "NotificationsDb": "Server=(localdb)\\MSSQLLocalDB;Database=XpressTest_Notifications;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Auth": {
    "Authority": "http://localhost:5101"
  },
  "Hangfire": {
    "WorkerCount": 5
  },
  "Email": {
    "From": "orders@xpress.local",
    "FromName": "Xpress Orders",
    "Delivery": "Smtp",
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": ""
    }
  }
}
