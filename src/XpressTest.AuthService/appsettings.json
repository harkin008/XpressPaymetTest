{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "UseInMemoryDb": false,
    "UseSqlServer": true
  },
  "ConnectionStrings": {
    "AuthDb": "Server=(localdb)\\MSSQLLocalDB;Database=XpressTest_Auth;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Ids": {
    "WorkerId": 1
  },
  "Jwt": {
    "Issuer": "http://localhost:5101",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "ClientTokenLifetime": "01:00:00",
    "UserAudiences": [ "order-service", "auth-service" ],
    "ApiScopes": {
      "notifications.send": "notification-service"
    }
  }
}
